# AgentLLM Gateway（统一AI聚合平台）
# 文档: https://agentllm.linkyun.co/docs
AGENTLLM_BASE_URL=https://agentllm.linkyun.co
AGENTLLM_API_KEY=sk-在这里填入你的租户密钥

# Embedding 提供方：gateway（AgentLLM 线上，推荐）| local（本地 sentence-transformers）
# 运行时也可热切换：PUT /api/v1/embeddings/provider {"kind":"gateway","model":"text-embedding-3-large"}
EMBEDDING_PROVIDER=gateway
# 轻量默认；生产推荐 BAAI/bge-m3（1024维，下载约2.3GB）
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DEVICE=cpu   # cpu | mps(Apple芯片) | cuda
GATEWAY_EMBEDDING_MODEL=text-embedding-3-large

# 数据层（docker compose up -d）
DATABASE_URL=postgresql://soulframe:soulframe@localhost:5433/soulframe

# 后端端口（与 frontend/vite.config.ts 的代理目标保持一致）
API_PORT=8787
REDIS_URL=redis://localhost:6379/0

# LLM（默认按预检实测：实时链路 M2-her）
# CHAT_MODEL=M2-her

# 语音通话打断平衡（可选）：阈值 0~1 越高越不易被环境音误打断；静音判停毫秒越大断句越稳
# REALTIME_VAD_THRESHOLD=0.6
# REALTIME_VAD_SILENCE_MS=700

# AI 形象工厂（文生/图生 3D + 自动绑骨 + 官方动画），二选一即可（都填优先 Meshy 主链）
# 注册领取：https://www.meshy.ai/api（≈44 credits/角色含 3 个动画） 或 https://platform.tripo3d.ai
# MESHY_API_KEY=
# MESHY_API_KEY_BACKUP=   # 备用 Key（主 Key 402 余额不足时手动换上）
# TRIPO_API_KEY=

# AgentMem 统一记忆（预留对接位）：填好 base_url 即启用记忆检索/写入挂点，
# 未配置时平台不处理记忆（当前拍板行为）
# AGENTMEM_BASE_URL=
# AGENTMEM_API_KEY=

# 图像生成模型链（默认先试 gpt-image-2，渠道未开通自动降级 linkyun-image-default）
# IMAGE_MODELS=["gpt-image-2","linkyun-image-default"]
